# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/melare
# Public address of the site, no trailing slash. Used in emails and payment links.
# Set it before running "npm run build".
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
CRON_SECRET=

# PayPal (also takes debit and credit cards)
# Create an app at https://developer.paypal.com/dashboard/applications
# "sandbox" for testing, "live" for real money. The keys differ for each.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The ID of the webhook you add to that app (needs a public https address)
PAYPAL_WEBHOOK_ID=

# Email through Resend: https://resend.com/api-keys
# Leave the key empty to log emails instead of sending them.
RESEND_API_KEY=
# Must use a domain verified at https://resend.com/domains. The test sender below
# only delivers to the email address of your own Resend account.
EMAIL_FROM="MelareBeauty <onboarding@resend.dev>"
# Fallback recipient for new bookings and orders (can also be set in Admin > Settings)
CONTACT_EMAIL=

# Optional: the Resend segment newsletter subscribers are copied into
RESEND_SEGMENT_ID=
# Optional: full path to mysqldump, if backups cannot find it
MYSQLDUMP_PATH=
# Set to 1 only if your host runs the scheduled tasks itself
DISABLE_SCHEDULER=
