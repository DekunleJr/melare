{
  "name": "melare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "backup": "tsx --conditions=react-server --env-file=.env.local scripts/backup.ts",
    "restore": "tsx --conditions=react-server --env-file=.env.local scripts/restore.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local db/seed.ts",
    "create-admin": "tsx --conditions=react-server --env-file=.env.local scripts/create-admin.ts",
    "db:refresh-samples": "tsx --conditions=react-server --env-file=.env.local scripts/refresh-samples.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "better-auth": "^1.7.28",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.80.0",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
